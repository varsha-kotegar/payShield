# ─────────────────────────────────────────────────────────────
#  PayShield — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string-in-production
PORT=5000

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-also-long-and-random
JWT_EXPIRY_HOURS=24

# ── RSA Keys — Key Management Mode ──────────────────────────
# Options: "file" | "env" | "aws_kms"
KEY_BACKEND=file

# file mode: keys are loaded from keys/ directory (default, dev only)
# PRIVATE_KEY_PATH=keys/private_key.pem
# PUBLIC_KEY_PATH=keys/public_key.pem

# env mode: paste the PEM content directly as env vars (recommended for cloud)
# PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----

# aws_kms mode: uses AWS KMS for signing (most secure, production)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-south-1
# KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789:key/your-key-id

# ── Database ─────────────────────────────────────────────────
# Options: "sqlite" | "postgresql"
DB_BACKEND=sqlite

# sqlite (default, dev only)
# SQLITE_PATH=database/payments.db

# postgresql (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/payshield

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Receipt Settings ─────────────────────────────────────────
RECEIPT_EXPIRY_MINUTES=15

# ── GST / Business Info ──────────────────────────────────────
BUSINESS_NAME=PayShield Payments Pvt Ltd
BUSINESS_GSTIN=29AABCP1234A1ZK
BUSINESS_ADDRESS=123, MG Road, Belagavi, Karnataka - 590001
BUSINESS_PAN=AABCP1234A
BUSINESS_EMAIL=billing@payshield.in
BUSINESS_PHONE=+91-9876543210
